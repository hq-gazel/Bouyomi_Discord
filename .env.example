# =============================================================
# Bouyomi_Discord 環境設定テンプレート
# このファイルを .env にコピーし、各値を実際の設定に置き換えること。
# .env はgitignore対象のため、実際のトークン等はコミットされない。
# =============================================================

# -------------------------------------------------------------
# Discord
# -------------------------------------------------------------
# Discord Developer Portal で発行したBotトークン(必須)
DISCORD_BOT_TOKEN=

# 管理者 (監査するユーザー) として扱うDiscordユーザーID(必須、数値)
DISCORD_ADMIN_USER_ID=

# Botを動作させる対象のDiscordサーバー(ギルド)ID(任意、未設定なら全ギルド対象)
DISCORD_GUILD_ID=

# 管理者のオンライン状態などをチェックする間隔(秒、任意、デフォルト5.0)
ADMIN_CHECK_INTERVAL_SECONDS=5.0

# -------------------------------------------------------------
# Twitch
# -------------------------------------------------------------
# Twitch Developer ConsoleでのアプリケーションClient ID(必須)
TWITCH_CLIENT_ID=

# TwitchチャットBot用のOAuthトークン("oauth:"から始まる形式、必須)
TWITCH_OAUTH_TOKEN=

# TwitchチャットBotのニックネーム(必須)
TWITCH_BOT_NICK=

# コメントを取得する対象のTwitchチャンネル名(必須)
TWITCH_CHANNEL=

# -------------------------------------------------------------
# Irodori-TTS連携
# -------------------------------------------------------------
# Irodori-TTSプロジェクトのルートディレクトリ(必須)
IRODORI_TTS_DIR=

# Irodori-TTS用の仮想環境Python実行ファイルパス(必須)
# 例: <irodori-TTSの場所>\.venv\Scripts\python.exe
IRODORI_TTS_VENV_PYTHON=

# HuggingFace上のIrodori-TTSチェックポイントID
# (IRODORI_TTS_CHECKPOINTと排他、どちらか一方は必須)
# 基本はデフォルトで問題ありません。モデルを切り替えられる人のみ。
IRODORI_TTS_HF_CHECKPOINT=Aratako/Irodori-TTS-500M-v3

# ローカルに配置したIrodori-TTSチェックポイントのパス
# (IRODORI_TTS_HF_CHECKPOINTと排他、どちらか一方は必須)
IRODORI_TTS_CHECKPOINT=

# 固定話者として使用する参照音声wavファイルのパス(必須)
IRODORI_TTS_REF_WAV=

# -------------------------------------------------------------
# TTSサイドカーサーバー
# -------------------------------------------------------------
# TTSサーバーのバインドホスト(任意、デフォルト127.0.0.1)
TTS_SERVER_HOST=127.0.0.1

# TTSサーバーのバインドポート(任意、デフォルト8765)
TTS_SERVER_PORT=8765

# -------------------------------------------------------------
# ffmpeg設定
# -------------------------------------------------------------
# ffmpeg実行ファイルのパス(任意、未設定ならPATH上のffmpegを使用)
# 但し、Discord上で音声再生するには必要なのでインストールすること
FFMPEG_PATH=
