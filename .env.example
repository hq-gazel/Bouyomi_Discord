# =============================================================
# Bouyomi_Discord 環境設定テンプレート
# このファイルを .env にコピーし、各値を実際の設定に置き換えること。
# .env はgitignore対象のため、実際のトークン等はコミットされない。
# =============================================================

# -------------------------------------------------------------
# ロギング
# -------------------------------------------------------------
# ルートロガーをDEBUGレベルにするか(任意、デフォルトfalse)
# 通常運転時はfalseのままでよい(INFOレベルで動作する)。
DEBUG_LOGGING=false

# -------------------------------------------------------------
# Discord
# -------------------------------------------------------------
# Discord Developer Portal で発行したBotトークン(必須)
DISCORD_BOT_TOKEN=

# 管理者 (監査するユーザー) として扱うDiscordユーザーID(必須、数値)
DISCORD_ADMIN_USER_ID=

# Botを動作させる対象のDiscordサーバー(ギルド)ID(任意、未設定なら全ギルド対象)
DISCORD_GUILD_ID=

# 管理者のオンライン状態などをチェックする間隔(秒、任意、デフォルト5.0)
ADMIN_CHECK_INTERVAL_SECONDS=5.0

# 1回の音声再生が完了とみなされずタイムアウトするまでの秒数(任意、デフォルト30.0)
# ffmpegのハング等で再生が詰まった場合に強制復旧するための上限時間。
PLAYBACK_TIMEOUT_SECONDS=30.0

# -------------------------------------------------------------
# 合成/再生の連続失敗時のリトライ制御
# -------------------------------------------------------------
# 合成/再生が失敗した際、再試行までの最初の待機秒数(任意、デフォルト1.0)
# 失敗のたびに指数的に(2倍ずつ)増加していく。
RETRY_BACKOFF_INITIAL_SECONDS=1.0

# 再試行までの待機秒数の上限(任意、デフォルト30.0)
RETRY_BACKOFF_MAX_SECONDS=30.0

# 連続失敗がこの回数に達したらサーキットオープンとして扱う閾値(任意、デフォルト5)
RETRY_CIRCUIT_OPEN_THRESHOLD=5

# サーキットオープン中に再試行する間隔(秒、任意、デフォルト60.0)
RETRY_CIRCUIT_OPEN_INTERVAL_SECONDS=60.0

# -------------------------------------------------------------
# Twitch
# -------------------------------------------------------------
# Twitch Developer ConsoleでのアプリケーションClient ID(必須)
TWITCH_CLIENT_ID=

# TwitchチャットBot用のOAuthトークン("oauth:"から始まる形式、必須)
TWITCH_OAUTH_TOKEN=

# TwitchチャットBotのニックネーム(必須)
TWITCH_BOT_NICK=

# コメントを取得する対象のTwitchチャンネル名(必須)
TWITCH_CHANNEL=

# 読み上げ前にコメントへ適用するテンプレート文字列(任意)
# デフォルト: "{username}さん、{comment}"
# 使用可能なプレースホルダーは {username}(発言者名) と {comment}(コメント本文) のみ。
# {username} は cfg/user_aliases.json に該当ログイン名のエイリアスが
# 登録されていればそれを、未登録ならTwitchの表示名をそのまま使う。
TWITCH_COMMENT_TEMPLATE={username}さん、{comment}

# -------------------------------------------------------------
# Irodori-TTS連携
# -------------------------------------------------------------
# Irodori-TTSプロジェクトのルートディレクトリ(必須)
IRODORI_TTS_DIR=

# Irodori-TTS用の仮想環境Python実行ファイルパス(必須)
# 例: <irodori-TTSの場所>\.venv\Scripts\python.exe
IRODORI_TTS_VENV_PYTHON=

# HuggingFace上のIrodori-TTSチェックポイントID
# (IRODORI_TTS_CHECKPOINTと排他、どちらか一方は必須)
# 基本はデフォルトで問題ありません。モデルを切り替えられる人のみ。
IRODORI_TTS_HF_CHECKPOINT=Aratako/Irodori-TTS-500M-v3

# ローカルに配置したIrodori-TTSチェックポイントのパス
# (IRODORI_TTS_HF_CHECKPOINTと排他、どちらか一方は必須)
IRODORI_TTS_CHECKPOINT=

# 固定話者として使用する参照音声wavファイルのパス(必須)
IRODORI_TTS_REF_WAV=

# モデルの推論精度(任意、デフォルトauto)
# autoの場合、CUDA検出時はbf16、CPUの場合はfp32に自動解決される。
IRODORI_TTS_MODEL_PRECISION=auto

# 参照音声のエンコード(コーデック)を実行するデバイス(任意、デフォルトauto)
# autoの場合、CUDA使用可能ならcuda、それ以外はcpuに自動解決される。
IRODORI_TTS_CODEC_DEVICE=auto

# torch.compileによるモデルの事前コンパイルを有効にするか(任意、デフォルトtrue)
# 有効時は起動時に1回ウォームアップ合成を行い、初回コンパイルのコストを
# 前倒しする。起動が不安定な場合はfalseにして無効化できる。
IRODORI_TTS_COMPILE_MODEL=true

# torch.compileの動的shape対応を有効にするか(任意、デフォルトtrue)
# テキスト長が可変なため、有効にしないとテキスト長ごとに再コンパイルが発生する。
IRODORI_TTS_COMPILE_DYNAMIC=true

# 音声合成のEuler積分ステップ数(任意、デフォルト28)
# 大きいほど生成精度が上がるが低速化する(Irodori-TTS本体のデフォルトは40)。
# 生成精度と生成速度のバランスを取った値として28を設定している。
IRODORI_TTS_NUM_STEPS=28

# 候補デコード方式(任意、デフォルトbatch)
# "sequential": 候補を1つずつデコードしVRAM使用量が少ない。
# "batch": 候補をまとめてデコードし高速(VRAMに余裕がある場合向け)。
IRODORI_TTS_DECODE_MODE=batch

# -------------------------------------------------------------
# TTSサイドカーサーバー
# -------------------------------------------------------------
# TTSサーバーのバインドホスト(任意、デフォルト127.0.0.1)
TTS_SERVER_HOST=127.0.0.1

# TTSサーバーのバインドポート(任意、デフォルト8765)
TTS_SERVER_PORT=8765

# TTSサーバーが起動完了(healthy)になるまでのタイムアウト秒数(任意、デフォルト600.0)
# torch.compileウォームアップ込みで初回起動が伸びるための猶予。
TTS_STARTUP_TIMEOUT_SECONDS=600.0

# TTS合成のステージ別タイミングログを標準出力に出すか(任意、デフォルトfalse)
TTS_DEBUG_LOGGING=false

# TTSサーバーへの/synthesizeリクエストのタイムアウト秒数(任意、デフォルト60.0)
TTS_SYNTHESIZE_TIMEOUT_SECONDS=60.0

# TTSサーバーへの/healthリクエストのタイムアウト秒数(任意、デフォルト5.0)
TTS_HEALTH_CHECK_TIMEOUT_SECONDS=5.0

# TTSサイドカーサブプロセスをterminate()してからkill()に切り替えるまでの
# 猶予秒数(任意、デフォルト10.0)
TTS_SHUTDOWN_TIMEOUT_SECONDS=10.0

# -------------------------------------------------------------
# ffmpeg設定
# -------------------------------------------------------------
# ffmpeg実行ファイルのパス(任意、未設定ならPATH上のffmpegを使用)
# 但し、Discord上で音声再生するには必要なのでインストールすること
FFMPEG_PATH=
